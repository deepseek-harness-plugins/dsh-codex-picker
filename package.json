{
  "name": "@deepseekharness-plugin/dsh-codex-picker",
  "version": "0.1.0",
  "description": "DeepSeek Harness Codex 风格模型与思考强度选择器",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness-plugins/dsh-codex-picker.git"
  },
  "bugs": {
    "url": "https://github.com/deepseek-harness-plugins/dsh-codex-picker/issues"
  },
  "homepage": "https://github.com/deepseek-harness-plugins/dsh-codex-picker#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/picker-state-test.mjs && node scripts/ui-test.mjs",
    "check": "npm run build && npm test && npm run test:ui",
    "test:integration": "node scripts/integration-test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.56.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
